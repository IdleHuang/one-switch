{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    // 增量信息写在 `node_modules/.cache` 下：CI 把这个目录缓存到 lint / typecheck 各自的
    // job 名下，本地跑也不会在仓库根留下文件。本机实测约 17s → 7s。
    // tsc 自己按文件内容与选项校验增量信息，命中的前提是「这些文件上次已检查过且无误」，
    // 上一次带错误时它会整份重查，所以不会把新问题藏起来。
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.check.tsbuildinfo"
  },
  // 比 `tsconfig.json` 多出「不该被业务代码 import、但必须单独成立」的文件：
  // 两个构建配置、测试配置和 drizzle 配置都在这个程序里一起检查。
  "include": [
    "packages/contracts/source/**/*.ts",
    "packages/core/source/**/*.ts",
    "packages/console/source/**/*.ts",
    "packages/console/source/**/*.tsx",
    "apps/app/source/**/*.ts",
    "apps/cli/source/**/*.ts",
    "packages/console/vite.config.ts",
    "packages/core/drizzle.config.ts",
    "apps/app/vite.config.ts",
    "apps/app/vite.preload.config.ts",
    "apps/app/vite.shared.ts",
    "apps/cli/vite.config.ts",
    "vitest.config.ts",
    "packages/console/scripts/vitest.setup.ts"
  ],
  "references": []
}
